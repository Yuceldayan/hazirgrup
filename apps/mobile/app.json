{
  "expo": {
    "name": "HazırGrup",
    "slug": "hazirgrup",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hazirgrup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#4F46E5",
    "splash": {
      "backgroundColor": "#4F46E5",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hazirgrup.mobile"
    },
    "android": {
      "package": "app.hazirgrup.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hazirgrup.app",
              "pathPrefix": "/davet"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
