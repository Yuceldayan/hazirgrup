# ============================================================================
#  HazırGrup — Ortam Değişkenleri
# ----------------------------------------------------------------------------
#  Bu dosyayı `.env.local` olarak kopyalayın ve doldurun.
#
#  ÖNEMLİ: Hiçbir değişken ZORUNLU DEĞİLDİR.
#  Supabase anahtarları tanımlı değilse uygulama otomatik olarak DEMO moduna
#  düşer: seed verisiyle dolu, bellek içi bir veri kaynağı kullanır ve tüm
#  akışlar (plan, davet, oy, rezervasyon) eksiksiz çalışır.
#  Ayrıntı: docs/SETUP.md
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Veri kaynağı
# ---------------------------------------------------------------------------
# 'auto'     → Supabase anahtarları varsa supabase, yoksa demo (varsayılan)
# 'demo'     → Her zaman bellek içi demo verisi
# 'supabase' → Her zaman Supabase (anahtar yoksa hata verir)
HG_DATA_SOURCE=auto

# ---------------------------------------------------------------------------
# 2. Supabase (opsiyonel)
# ---------------------------------------------------------------------------
# Local geliştirme için `supabase start` çıktısındaki değerleri kullanın.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafında kullanılır (admin işlemleri, seed).
# ASLA istemciye sızdırmayın, ASLA repoya yazmayın.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 3. Site
# ---------------------------------------------------------------------------
# Canonical URL, sitemap ve OG görselleri için kullanılır. Sonunda / olmamalı.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 'development' | 'staging' | 'production'
# 'production' dışındaki değerlerde robots.txt tüm siteyi kapatır (noindex).
NEXT_PUBLIC_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# 4. Oturum
# ---------------------------------------------------------------------------
# Demo modda oturum ve misafir cookie'lerini imzalamak için kullanılır.
# Üretimde en az 32 karakterlik rastgele bir değer verin.
HG_SESSION_SECRET=degistir-bu-degeri-en-az-32-karakter-olsun

# ---------------------------------------------------------------------------
# 5. Google ile giriş (opsiyonel)
# ---------------------------------------------------------------------------
# Tanımlı değilse "Google ile devam et" butonu GÖSTERİLMEZ, uygulama bozulmaz.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 6. Mobil uygulama (apps/mobile/.env)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_DATA_SOURCE=auto

# ---------------------------------------------------------------------------
# 7. Bildirim (opsiyonel)
# ---------------------------------------------------------------------------
# Tanımlı değilse push gönderilmez; uygulama içi bildirim merkezi çalışır.
EXPO_PUBLIC_PUSH_ENABLED=false
